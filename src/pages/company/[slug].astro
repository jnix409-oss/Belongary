---
import BaseLayout from '../../layouts/BaseLayout.astro';
import companies from '../../data/companies.json';
import { DIMENSIONS } from '../../data/dimensions';
import { LENSES } from '../../data/lenses';
import { INTERVIEW_QUESTIONS } from '../../data/interview-questions';
import { MIN_REVIEWS_DISPLAY, MIN_REVIEWS_SENSITIVE_LENS } from '../../config';

export function getStaticPaths() {
  return companies.map(c => ({ params: { slug: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
const reviewCount = company.reviewCount ?? 0;
const hasScores = reviewCount >= MIN_REVIEWS_DISPLAY;
const remaining = Math.max(0, MIN_REVIEWS_DISPLAY - reviewCount);
const pct = Math.min(100, Math.round((reviewCount / MIN_REVIEWS_DISPLAY) * 100));
const reviewParam = encodeURIComponent(company.name);
---
<BaseLayout title={company.name} description={`Belonging scores and anonymous workplace reviews for ${company.name}.`}>
  {!hasScores && (
    <Fragment slot="head">
      <meta name="robots" content="noindex, nofollow" />
    </Fragment>
  )}
  <!-- Peach Header -->
  <section class="bg-peach pt-6 pb-10 sm:pt-8 sm:pb-14">
    <div class="max-w-content mx-auto px-4">
      <nav class="text-sm mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="text-terra hover:text-terra-dark transition-colors font-medium">Explore</a></li>
          <li class="text-ink/30" aria-hidden="true">/</li>
          <li class="text-ink/60" aria-current="page">{company.name}</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-[1fr_auto] gap-8 items-end">
        <div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-plum mb-3">
            {company.name}
          </h1>
          <p class="text-ink/60 mb-6">
            Explore this workplace through different perspectives.
          </p>
          <a
            href={`/review?company=${reviewParam}`}
            class="inline-flex items-center gap-2 px-6 py-3 bg-terra text-white font-semibold rounded-xl hover:bg-terra-dark transition-colors shadow-sm"
          >
            Share your experience <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="hidden lg:block" aria-hidden="true">
          <div class="w-36 h-48 arch-outline border-2 border-terra/15 relative">
            <div class="absolute inset-3 arch-outline bg-terra/[0.04]"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tab Navigation -->
  <div class="border-b border-border bg-white sticky top-[73px] z-40">
    <div class="max-w-content mx-auto px-4">
      <nav class="flex gap-6 sm:gap-8" aria-label="Company sections">
        <button class="py-3 text-sm font-medium text-plum border-b-2 border-terra" aria-current="page">
          Overview
        </button>
        <button class="py-3 text-sm font-medium text-ink/40 border-b-2 border-transparent cursor-default" disabled>
          Lens insights
        </button>
        <button class="py-3 text-sm font-medium text-ink/40 border-b-2 border-transparent cursor-default" disabled>
          <span class="hidden sm:inline">About this employer</span><span class="sm:hidden">About</span>
        </button>
      </nav>
    </div>
  </div>

  <div class="max-w-content mx-auto px-4 py-10 sm:py-14">
    <!-- About this employer -->
    <section class="mb-12">
      <h2 class="text-2xl font-heading font-semibold text-plum mb-4">About this employer</h2>
      <div class="flex flex-col sm:flex-row flex-wrap gap-6 sm:gap-10">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-terra shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <div>
            <p class="text-xs text-ink/40">Industry</p>
            <p class="text-sm font-medium text-plum">{company.industry}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-terra shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <div>
            <p class="text-xs text-ink/40">Location</p>
            <p class="text-sm font-medium text-plum">{company.hq_metro}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-terra shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
          <div>
            <p class="text-xs text-ink/40">Source</p>
            <p class="text-sm font-medium text-plum">Public directory</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Lens Selector -->
    <section class="mb-10">
      <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-plum mb-2 text-center">
        See this workplace through your lens.
      </h2>
      <p class="text-sm text-ink/50 mb-6 text-center">
        Browsing a lens does not add it to your profile.
      </p>
      {hasScores ? (
        <div class="flex flex-wrap justify-center gap-2">
          <button class="px-5 py-2 rounded-full text-sm font-medium bg-plum text-white">All perspectives</button>
          {LENSES.map(lens => (
            <button class="px-5 py-2 rounded-full text-sm font-medium bg-white border border-border text-ink/60 hover:border-plum/30 transition-colors">
              {lens.label}
            </button>
          ))}
        </div>
      ) : (
        <div>
          <div class="flex flex-wrap justify-center gap-2">
            <span class="px-5 py-2 rounded-full text-sm font-medium bg-lavender/30 text-ink/30 cursor-default">All perspectives</span>
            {LENSES.map(lens => (
              <span class="px-5 py-2 rounded-full text-sm font-medium bg-white border border-border text-ink/25 cursor-default">
                {lens.label}
              </span>
            ))}
          </div>
          <p class="text-xs text-ink/30 text-center mt-3">Available once reviews reach the display threshold</p>
        </div>
      )}
    </section>

    {hasScores ? (
      <!-- Scores display — renders once MIN_REVIEWS_DISPLAY is met -->
      <div class="space-y-10 mb-12">
        <section>
          <h2 class="text-xl sm:text-2xl font-heading font-semibold text-plum mb-6">
            Would you recommend this employer to someone like you?
          </h2>
          <p class="text-sm text-ink/40">Score display will render from live data.</p>
        </section>

        <section>
          <h2 class="text-xl sm:text-2xl font-heading font-semibold text-plum mb-2">Everyday experience</h2>
          <p class="text-sm text-ink/40">Dimension bars will render from live data.</p>
        </section>
      </div>
    ) : (
      <!-- Collecting Perspectives + Preview -->
      <div class="mb-12 space-y-10">
        <!-- Progress card -->
        <div class="bg-white rounded-2xl border border-border p-8 sm:p-10 text-center max-w-2xl mx-auto">
          <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-lavender-light flex items-center justify-center">
            <img src="/brand/icons/belonging.svg" alt="" width="32" height="32" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-heading font-semibold text-plum mb-3">
            Collecting perspectives
          </h3>
          <p class="text-sm text-ink/60 mb-8 max-w-md mx-auto">
            Belonging scores for {company.name} will appear once {MIN_REVIEWS_DISPLAY} people have shared their experience. This threshold protects reviewer anonymity — it is never waived.
          </p>

          <div class="max-w-sm mx-auto mb-8">
            <div
              class="w-full bg-peach/30 rounded-full h-3 overflow-hidden"
              role="progressbar"
              aria-valuenow={reviewCount}
              aria-valuemin={0}
              aria-valuemax={MIN_REVIEWS_DISPLAY}
              aria-label={`${reviewCount} of ${MIN_REVIEWS_DISPLAY} reviews collected`}
            >
              <div
                class="h-full rounded-full transition-all duration-500"
                style={`width: ${pct}%; background-color: ${reviewCount > 0 ? '#B84E3B' : '#E3D8CC'};`}
              ></div>
            </div>
            <p class="text-sm font-medium text-ink/50 mt-3">
              {reviewCount} of {MIN_REVIEWS_DISPLAY} reviews collected
            </p>
          </div>

          <a
            href={`/review?company=${reviewParam}`}
            class="inline-flex items-center justify-center px-7 py-3 bg-terra text-white font-semibold rounded-xl hover:bg-terra-dark transition-colors shadow-sm"
          >
            Be one of the first {remaining}
          </a>
        </div>

        <!-- What you'll see — score previews -->
        <div class="max-w-2xl mx-auto">
          <h3 class="text-lg font-heading font-semibold text-plum mb-5">
            What you'll see once scores are live
          </h3>

          <!-- Headline score preview -->
          <div class="bg-white rounded-xl border border-border p-6 mb-4">
            <p class="text-sm font-medium text-ink/40 mb-4">Would you recommend this employer to someone like you?</p>
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-lg bg-sage-light/40 p-4 text-center">
                <p class="text-xs text-ink/30 mb-1">Yes</p>
                <p class="text-2xl font-heading font-bold text-ink/15">—</p>
              </div>
              <div class="rounded-lg bg-peach-light/60 p-4 text-center">
                <p class="text-xs text-ink/30 mb-1">Depends</p>
                <p class="text-2xl font-heading font-bold text-ink/15">—</p>
              </div>
              <div class="rounded-lg bg-peach/20 p-4 text-center">
                <p class="text-xs text-ink/30 mb-1">No</p>
                <p class="text-2xl font-heading font-bold text-ink/15">—</p>
              </div>
            </div>
          </div>

          <!-- Dimension bars preview -->
          <div class="bg-white rounded-xl border border-border p-6 mb-4">
            <p class="text-sm font-medium text-ink/40 mb-1">Everyday experience</p>
            <p class="text-xs text-ink/25 mb-5">Ratings on a 1–5 scale across eight dimensions of belonging</p>
            <div class="space-y-3.5">
              {DIMENSIONS.map(dim => (
                <div class="flex items-center gap-3">
                  <img src={dim.icon} alt="" width="20" height="20" class="opacity-25" aria-hidden="true" />
                  <span class="text-sm text-ink/30 w-44 shrink-0">{dim.label}</span>
                  <div class="flex-1 h-2.5 bg-peach/15 rounded-full"></div>
                  <span class="text-xs text-ink/20 w-8 text-right">— / 5</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Lens insights preview -->
          <div class="bg-white rounded-xl border border-border p-6">
            <p class="text-sm font-medium text-ink/40 mb-1">Identity lens insights</p>
            <p class="text-xs text-ink/25 mb-4">
              Scores filtered by perspective — requires {MIN_REVIEWS_SENSITIVE_LENS} reviews per lens
            </p>
            <div class="flex flex-wrap gap-2">
              {LENSES.map(lens => (
                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs bg-lavender/20 text-ink/20">
                  {lens.label}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- "When there isn't enough feedback" notice -->
    <section class="mb-12">
      <div class="flex items-start gap-4 p-5 sm:p-6 rounded-xl bg-sage-light/50 border border-sage/20">
        <div class="w-10 h-10 rounded-full bg-sage/20 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-sage-dark" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-heading font-semibold text-plum mb-1">When there isn't enough feedback</h3>
          <p class="text-sm text-ink/60 mb-2">
            We withhold lens results until privacy thresholds are met. Missing results do not mean a poor experience.
          </p>
          <a href="/methodology" class="text-sm font-medium text-terra hover:text-terra-dark transition-colors">
            How results are calculated <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Interview Questions -->
    <section class="mb-12">
      <h2 class="text-2xl font-heading font-semibold text-plum mb-6">
        Questions to take into your interview
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {INTERVIEW_QUESTIONS.map(q => (
          <div class="flex items-center gap-4 p-5 bg-white rounded-xl border border-border">
            <div class="w-10 h-10 rounded-lg bg-terra/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-terra" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-plum flex-1">{q.question}</p>
            <span class="text-terra shrink-0" aria-hidden="true">&rarr;</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/40 mt-3 text-center">
        General prompts, not findings about this employer.
      </p>
    </section>
  </div>

  <!-- Bottom CTA -->
  <section class="py-14 sm:py-16 bg-peach-light/30">
    <div class="max-w-narrow mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-10">
        <div class="hidden sm:block shrink-0" aria-hidden="true">
          <div class="w-20 h-28 arch-outline border-2 border-terra/15 relative">
            <div class="absolute inset-2 arch-outline bg-terra/[0.04]"></div>
          </div>
        </div>
        <div class="text-center sm:text-left">
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-plum mb-4">
            Your perspective could help the next person.
          </h2>
          <a
            href={`/review?company=${reviewParam}`}
            class="inline-flex items-center gap-2 px-7 py-3 bg-terra text-white font-semibold rounded-xl hover:bg-terra-dark transition-colors shadow-sm"
          >
            Share your experience <span aria-hidden="true">&rarr;</span>
          </a>
          <p class="text-xs text-ink/40 mt-4">
            Your account details are not displayed with results.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
