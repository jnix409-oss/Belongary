---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewProgress from '../../components/ReviewProgress.astro';
import companies from '../../data/companies.json';
import { DIMENSIONS } from '../../data/dimensions';
import { LENSES, getLensLabel } from '../../data/lenses';
import { hasThreshold, getThreshold, getScoreColor, getScoreLabel, getHeadlineBadge } from '../../data/thresholds';

export function getStaticPaths() {
  return companies.map(c => ({ params: { slug: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
const reviewCount = (company as any).reviewCount ?? 0;
const reviews = (company as any).reviews ?? [];
const threshold = getThreshold();
const meetsThreshold = hasThreshold(reviewCount);
---
<BaseLayout title={company.name} description={`Workplace belonging profile for ${company.name}. ${company.industry} · ${company.hq_metro}.`}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
    <!-- Company Header -->
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-2">{company.name}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-ink/50">
        <span>{company.industry}</span>
        <span class="text-border">·</span>
        <span>{company.hq_metro}</span>
      </div>
    </div>

    {meetsThreshold ? (
      <!-- Scores would render here once real reviews exist -->
      <div class="bg-white rounded-xl border border-border p-8 mb-8 text-center">
        <p class="text-ink/60">Scores are live. This state is not yet reachable.</p>
      </div>
    ) : (
      <!-- Progress state: not enough reviews -->
      <ReviewProgress
        count={reviewCount}
        companyName={company.name}
        threshold={threshold}
      />
    )}

    <!-- Dimensions list (informational, no scores) -->
    <div class="mt-10">
      <h2 class="text-xl font-heading font-semibold text-plum mb-6">What We Measure</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {DIMENSIONS.map(dim => (
          <div class="bg-white rounded-xl border border-border p-5">
            <div class="flex items-center gap-3">
              <img src={dim.icon} alt="" width="24" height="24" class="text-plum" aria-hidden="true" />
              <p class="text-sm font-semibold text-plum">{dim.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <p class="text-ink/50 mb-4">Worked here? Add your voice.</p>
      <a
        href={`/review?company=${encodeURIComponent(company.name)}`}
        class="inline-flex items-center justify-center px-8 py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors shadow-sm"
      >
        Leave a Review
      </a>
    </div>
  </div>
</BaseLayout>
