---
import BaseLayout from '../../layouts/BaseLayout.astro';
import companies from '../../data/companies.json';
import { DIMENSIONS } from '../../data/dimensions';
import { LENSES, getLensLabel } from '../../data/lenses';
import { getConfidenceLevel, CONFIDENCE_CONFIG, getScoreColor, getScoreLabel, getHeadlineBadge } from '../../data/thresholds';

export function getStaticPaths() {
  return companies.map(c => ({ params: { slug: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
const reports = company.reports;
const headlinePct = Math.round((reports.yes / (reports.yes + reports.no)) * 100);
const badge = getHeadlineBadge(headlinePct);
const confidence = getConfidenceLevel(reports.n);
const confidenceInfo = CONFIDENCE_CONFIG[confidence];

const availableLenses = Object.entries(reports.by_lens || {}).filter(
  ([, data]: [string, any]) => data.n >= 5
);
---
<BaseLayout title={company.name} description={`Belonging scores for ${company.name} based on ${reports.n} anonymous reviews.`}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
    <!-- Company Header -->
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-2">{company.name}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-ink/50">
        <span>{company.industry}</span>
        <span class="text-border">·</span>
        <span>{company.hq_metro}</span>
        <span class="text-border">·</span>
        <span>{reports.n} reviews</span>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium" style={`background: ${confidenceInfo ? getScoreColor(headlinePct >= 70 ? 4 : headlinePct >= 40 ? 3 : 2) : '#EBA048'}15; color: ${confidenceInfo ? getScoreColor(headlinePct >= 70 ? 4 : headlinePct >= 40 ? 3 : 2) : '#EBA048'}`}>
          {confidenceInfo.label}
        </span>
      </div>
    </div>

    <!-- Lens Toggle -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2" id="lens-toggle">
        <button
          data-lens="all"
          class="lens-btn px-4 py-2 rounded-full text-sm font-medium border-2 transition-all bg-plum text-white border-plum"
        >
          Everyone
        </button>
        {availableLenses.map(([lensId]) => (
          <button
            data-lens={lensId}
            class="lens-btn px-4 py-2 rounded-full text-sm font-medium border-2 transition-all border-border text-ink/60 hover:border-plum/30"
          >
            {getLensLabel(lensId)}
          </button>
        ))}
        {Object.entries(reports.by_lens || {}).filter(([, data]: [string, any]) => data.n < 5).map(([lensId, data]: [string, any]) => (
          <span
            class="px-4 py-2 rounded-full text-sm font-medium border-2 border-border/50 text-ink/30 cursor-not-allowed"
            title={`${getLensLabel(lensId)} — ${data.n} review${data.n === 1 ? '' : 's'}, need ${5 - data.n} more`}
          >
            {getLensLabel(lensId)} ({data.n})
          </span>
        ))}
      </div>
    </div>

    <!-- Headline Score -->
    <div id="headline-section" class="bg-white rounded-xl border border-border p-8 mb-8">
      <p class="text-sm text-ink/50 mb-4 font-medium">
        "Would you tell someone like you to take this job?"
      </p>
      <div class="flex items-center gap-6 mb-6">
        <div class="text-center">
          <span id="headline-pct" class="text-5xl font-heading font-bold" style={`color: ${badge.color}`}>{headlinePct}%</span>
          <p id="headline-badge" class="text-sm font-medium mt-1" style={`color: ${badge.color}`}>{badge.label}</p>
          <p class="text-xs text-ink/40 mt-0.5">would say yes</p>
        </div>
        <!-- 3-way split bar -->
        <div class="flex-1">
          <div class="flex rounded-full overflow-hidden h-6 bg-light">
            <div id="bar-yes" class="bg-score-good flex items-center justify-center text-white text-xs font-medium" style={`width: ${reports.yes}%`}>
              {reports.yes}%
            </div>
            <div id="bar-depends" class="bg-score-mid flex items-center justify-center text-white text-xs font-medium" style={`width: ${reports.depends}%`}>
              {reports.depends}%
            </div>
            <div id="bar-no" class="bg-score-low flex items-center justify-center text-white text-xs font-medium" style={`width: ${reports.no}%`}>
              {reports.no}%
            </div>
          </div>
          <div class="flex justify-between mt-1 text-xs text-ink/40">
            <span>Yes</span>
            <span>Depends</span>
            <span>No</span>
          </div>
        </div>
      </div>
      <div id="suppression-notice" class="hidden bg-amber/5 border border-amber/20 rounded-lg p-4 text-sm text-ink/60">
      </div>
    </div>

    <!-- 8 Dimensions -->
    <div id="dimensions-section">
      <h2 class="text-xl font-heading font-semibold text-plum mb-6">Belonging Dimensions</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {DIMENSIONS.map(dim => {
          const score = reports.dimensions[dim.id as keyof typeof reports.dimensions];
          const color = getScoreColor(score);
          const label = getScoreLabel(score);
          return (
            <div class="dimension-card bg-white rounded-xl border border-border p-5" data-dim={dim.id}>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xl">{dim.icon}</span>
                <div class="flex-1">
                  <p class="text-sm font-semibold text-plum">{dim.label}</p>
                </div>
                <div class="text-right">
                  <span class="dim-score text-xl font-heading font-bold" style={`color: ${color}`}>{score.toFixed(1)}</span>
                  <p class="dim-label text-xs font-medium" style={`color: ${color}`}>{label}</p>
                </div>
              </div>
              <div class="w-full bg-light rounded-full h-2.5">
                <div class="dim-bar h-2.5 rounded-full transition-all duration-500" style={`width: ${(score / 5) * 100}%; background: ${color}`}></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <p class="text-ink/50 mb-4">Worked here? Add your voice.</p>
      <a href="/review" class="inline-flex items-center justify-center px-8 py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors shadow-sm">
        Leave a Review
      </a>
    </div>
  </div>

  <script define:vars={{ companyData: company, DIMENSIONS }}>
    const reports = companyData.reports;
    const byLens = reports.by_lens || {};

    function getHeadlineBadge(pct) {
      if (pct >= 70) return { label: 'Good', color: '#3E8E7E' };
      if (pct >= 40) return { label: 'Mixed', color: '#EBA048' };
      return { label: 'Low', color: '#D9645A' };
    }

    function getScoreColor(score) {
      if (score >= 3.5) return '#3E8E7E';
      if (score >= 2.5) return '#EBA048';
      return '#D9645A';
    }

    function getScoreLabel(score) {
      if (score >= 4.0) return 'Strong';
      if (score >= 3.5) return 'Good';
      if (score >= 2.5) return 'Mixed';
      return 'Low';
    }

    function getConfidenceLevel(n) {
      if (n < 5) return 'suppressed';
      if (n < 25) return 'early';
      if (n < 100) return 'directional';
      return 'reliable';
    }

    const confidenceLabels = {
      suppressed: 'Not enough reports yet',
      early: 'Early / Small Sample',
      directional: 'Directional',
      reliable: 'Reliable',
    };

    function updateView(lens) {
      const data = lens === 'all' ? reports : byLens[lens];
      const suppression = document.getElementById('suppression-notice');

      if (!data || data.n < 5) {
        suppression.classList.remove('hidden');
        suppression.textContent = `Not enough reports yet for this lens (currently at ${data?.n || 0}).`;
        document.getElementById('headline-section').querySelector('.flex.items-center.gap-6').classList.add('opacity-30');
        document.getElementById('dimensions-section').classList.add('opacity-30');
        return;
      }

      suppression.classList.add('hidden');
      document.getElementById('headline-section').querySelector('.flex.items-center.gap-6').classList.remove('opacity-30');
      document.getElementById('dimensions-section').classList.remove('opacity-30');

      const confidence = getConfidenceLevel(data.n);
      if (confidence === 'early' || confidence === 'directional') {
        suppression.classList.remove('hidden');
        suppression.textContent = `${confidenceLabels[confidence]} — based on ${data.n} reviews.`;
      }

      const pct = Math.round((data.yes / (data.yes + data.no)) * 100);
      const badge = getHeadlineBadge(pct);
      document.getElementById('headline-pct').textContent = pct + '%';
      document.getElementById('headline-pct').style.color = badge.color;
      document.getElementById('headline-badge').textContent = badge.label;
      document.getElementById('headline-badge').style.color = badge.color;

      document.getElementById('bar-yes').style.width = data.yes + '%';
      document.getElementById('bar-yes').textContent = data.yes + '%';
      document.getElementById('bar-depends').style.width = data.depends + '%';
      document.getElementById('bar-depends').textContent = data.depends + '%';
      document.getElementById('bar-no').style.width = data.no + '%';
      document.getElementById('bar-no').textContent = data.no + '%';

      if (data.dimensions) {
        document.querySelectorAll('.dimension-card').forEach(card => {
          const dimId = card.getAttribute('data-dim');
          const score = data.dimensions[dimId];
          if (score !== undefined) {
            const color = getScoreColor(score);
            const label = getScoreLabel(score);
            card.querySelector('.dim-score').textContent = score.toFixed(1);
            card.querySelector('.dim-score').style.color = color;
            card.querySelector('.dim-label').textContent = label;
            card.querySelector('.dim-label').style.color = color;
            card.querySelector('.dim-bar').style.width = (score / 5) * 100 + '%';
            card.querySelector('.dim-bar').style.background = color;
            card.classList.remove('opacity-30');
          }
        });
      }
    }

    document.querySelectorAll('.lens-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.lens-btn').forEach(b => {
          b.classList.remove('bg-plum', 'text-white', 'border-plum');
          b.classList.add('border-border', 'text-ink/60');
        });
        btn.classList.add('bg-plum', 'text-white', 'border-plum');
        btn.classList.remove('border-border', 'text-ink/60');
        updateView(btn.getAttribute('data-lens'));
      });
    });
  </script>
</BaseLayout>
