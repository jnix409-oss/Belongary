---
import BaseLayout from '../layouts/BaseLayout.astro';
import companies from '../data/companies.json';
import { DIMENSIONS } from '../data/dimensions';
import { LENSES } from '../data/lenses';

const companyNames = companies.map(c => c.name).sort();

const searchParams = Astro.url.searchParams;
const prefillCompany = searchParams.get('company') || '';
const prefillStory = searchParams.get('story') || '';

const pageTitle = "The stories nobody got to tell the next person";
const pageDescription = "Glassdoor tells you what people think of a company. Belongary tells you what people like you found there.";
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href="https://belongary.netlify.app/review" />
    <meta property="og:url" content="https://belongary.netlify.app/review" />
  </Fragment>

  <div class="max-w-2xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-3">
      The stories nobody got to tell the next person.
    </h1>
    <p class="text-ink/60 mb-8">
      Glassdoor tells you what people think of a company. Belongary tells you what people like you found there. Share yours below — anonymous, no work email required.
    </p>

    <form
      id="review-form"
      class="space-y-8"
    >
      <!-- Honeypot (spam prevention) -->
      <p class="hidden">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <!-- 1. Company -->
      <div class="relative">
        <label for="company" class="block text-sm font-semibold text-plum mb-1">Company *</label>
        <input
          type="text"
          name="company"
          id="company"
          required
          autocomplete="off"
          value={prefillCompany}
          placeholder="Start typing a company name..."
          class="w-full px-4 py-3 rounded-lg border border-border bg-white text-ink placeholder:text-ink/30 focus:outline-none focus:ring-2 focus:ring-coral/30 focus:border-coral"
        />
        <ul id="company-dropdown" class="hidden absolute z-10 w-full mt-1 max-h-48 overflow-y-auto bg-white border border-border rounded-lg shadow-lg"></ul>
        <p class="text-xs text-ink/40 mt-1">If your company isn't listed, type it in — we'll add it.</p>
      </div>

      <!-- 2. Headline Question -->
      <div class="bg-cream rounded-xl p-6 border border-border">
        <p class="text-lg font-heading font-semibold text-plum mb-4">
          In your opinion, would you tell someone like you to take this job?
        </p>
        <div class="flex flex-wrap gap-4">
          {['Yes', 'No', 'Depends'].map(opt => (
            <label class="flex-1 min-w-[100px]">
              <input type="radio" name="headline" value={opt.toLowerCase()} required class="peer hidden" />
              <div class="peer-checked:bg-coral peer-checked:text-white peer-checked:border-coral text-center py-3 px-4 rounded-lg border-2 border-border text-ink/70 font-semibold cursor-pointer hover:border-coral/50 transition-all">
                {opt}
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- 3. Story -->
      <div>
        <label for="story" class="block text-sm font-semibold text-plum mb-1">Your story *</label>
        <p class="text-sm text-ink/70 mb-2">What would you tell someone like you before they take this job?</p>
        <textarea
          name="story"
          id="story"
          required
          rows="6"
          class="w-full px-4 py-3 rounded-lg border border-border bg-white text-ink placeholder:text-ink/30 focus:outline-none focus:ring-2 focus:ring-coral/30 focus:border-coral resize-none"
        >{prefillStory}</textarea>
        <p class="text-xs text-ink/40 mt-1">
          No names, please — yours or anyone else's. <a href="/anonymity" class="text-coral hover:text-coral/80 underline">How we protect your anonymity</a>
        </p>
      </div>

      <!-- 4. Eight Dimensions -->
      <div>
        <h2 class="text-lg font-heading font-semibold text-plum mb-1">Rate These Dimensions</h2>
        <p class="text-sm text-ink/50 mb-4">1 = poor, 5 = excellent. Skip any you can't speak to.</p>
        <div class="space-y-4">
          {DIMENSIONS.map(dim => (
            <div class="flex items-center gap-4 p-3 rounded-lg bg-white border border-border">
              <img src={dim.icon} alt="" width="20" height="20" class="shrink-0" aria-hidden="true" />
              <div class="flex-1">
                <p class="text-sm font-medium text-plum">{dim.label}</p>
              </div>
              <div class="flex gap-1" role="radiogroup" aria-label={dim.label}>
                {[1, 2, 3, 4, 5].map(v => (
                  <label class="dimension-rating">
                    <input type="radio" name={`dim_${dim.id}`} value={v} class="peer hidden" />
                    <span class="peer-checked:bg-coral peer-checked:text-white peer-checked:border-coral w-9 h-9 flex items-center justify-center rounded-md border border-border text-sm font-medium text-ink/60 cursor-pointer hover:border-coral/50 transition-all">
                      {v}
                    </span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 5. Identity Lens (after investment, before submit) -->
      <div class="bg-cream-light rounded-xl p-6 border border-border">
        <div class="mb-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="lens-consent" name="lens_consent" value="yes" class="mt-1 accent-coral" />
            <div>
              <p class="text-sm font-semibold text-plum">I'd like to tag my review with an identity lens</p>
              <p class="text-xs text-ink/50 mt-1">
                Your lens is never published individually — it only appears in aggregate when 8 or more people from a company share the same lens. This is completely optional.
              </p>
            </div>
          </label>
        </div>

        <div id="lens-options" class="hidden">
          <p class="text-sm font-semibold text-plum mb-2">Select any that apply:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {LENSES.map(lens => (
              <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-white/50 cursor-pointer">
                <input type="checkbox" name="lens" value={lens.id} class="lens-checkbox accent-coral" disabled />
                <span class="text-sm text-ink/70">{lens.label}</span>
              </label>
            ))}
            <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-white/50 cursor-pointer">
              <input type="checkbox" name="lens" value="prefer-not-to-say" class="lens-checkbox accent-coral" disabled />
              <span class="text-sm text-ink/70">Prefer not to say</span>
            </label>
          </div>
        </div>
      </div>

      <!-- 6. Optional Email -->
      <div>
        <label for="email" class="block text-sm font-semibold text-plum mb-1">
          Email <span class="font-normal text-ink/40">(optional — for corrections/removal only)</span>
        </label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="your@email.com"
          class="w-full px-4 py-3 rounded-lg border border-border bg-white text-ink placeholder:text-ink/30 focus:outline-none focus:ring-2 focus:ring-coral/30 focus:border-coral"
        />
        <p class="text-xs text-ink/40 mt-1">
          Never published. Never used to verify employment. Stored separately from your review, used only as a fallback if you lose your removal token.
        </p>
      </div>

      <!-- Submissions paused — waiting on privacy review -->
      <div class="w-full py-4 px-6 bg-cream border border-border rounded-lg text-center">
        <p class="text-sm font-semibold text-plum mb-1">Submissions open soon.</p>
        <p class="text-xs text-ink/50">We're finishing our privacy review before we start collecting stories. Nothing is being saved right now.</p>
      </div>

      <!--
      <button
        type="submit"
        id="submit-btn"
        class="w-full py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors shadow-sm text-lg"
      >
        Submit Review
      </button>

      <div id="error-message" class="hidden mt-6 bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700"></div>
      -->
  </div>

  <script define:vars={{ companyNames }}>
    function setupAutocomplete(inputId, dropdownId, items, onSelect) {
      const input = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);
      if (!input || !dropdown) return;

      input.addEventListener('input', () => {
        const val = input.value.toLowerCase().trim();
        dropdown.innerHTML = '';
        if (val.length < 1) { dropdown.classList.add('hidden'); return; }
        const matches = items.filter(item => item.toLowerCase().includes(val)).slice(0, 10);
        if (matches.length === 0) { dropdown.classList.add('hidden'); return; }
        matches.forEach(item => {
          const li = document.createElement('li');
          li.textContent = item;
          li.className = 'px-4 py-2 cursor-pointer hover:bg-cream text-sm text-ink';
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            input.value = item;
            dropdown.classList.add('hidden');
            if (onSelect) onSelect(item);
          });
          dropdown.appendChild(li);
        });
        dropdown.classList.remove('hidden');
      });

      input.addEventListener('focus', () => {
        if (input.value.trim().length >= 1) input.dispatchEvent(new Event('input'));
      });

      input.addEventListener('blur', () => {
        setTimeout(() => dropdown.classList.add('hidden'), 150);
      });
    }

    setupAutocomplete('company', 'company-dropdown', companyNames, null);
  </script>

  <script>
    // Lens consent toggle
    const consent = document.getElementById('lens-consent');
    const lensOptions = document.getElementById('lens-options');
    const lensCheckboxes = document.querySelectorAll('.lens-checkbox');

    consent?.addEventListener('change', () => {
      const checked = (consent as HTMLInputElement).checked;
      lensOptions?.classList.toggle('hidden', !checked);
      lensCheckboxes.forEach(cb => {
        (cb as HTMLInputElement).disabled = !checked;
        if (!checked) (cb as HTMLInputElement).checked = false;
      });
    });

    // --- Submissions paused: form handler, success block, and copy buttons
    // --- are commented out until privacy review is complete. ---
    // --- To re-enable: restore submit button from HTML comment above,
    // --- uncomment success-message div, uncomment this JS block,
    // --- and re-add SUPABASE_SERVICE_ROLE_KEY to Netlify env vars. ---
  </script>
</BaseLayout>
