---
import BaseLayout from '../../layouts/BaseLayout.astro';
import companies from '../../data/companies.json';
import { LENSES, getLensLabel } from '../../data/lenses';
import { getThreshold } from '../../data/thresholds';

export function getStaticPaths() {
  return LENSES.map(lens => ({ params: { lens: lens.id }, props: { lensId: lens.id, lensLabel: lens.label } }));
}

const { lensId, lensLabel } = Astro.props;
const threshold = getThreshold(true); // sensitive lens threshold

// Alphabetical — no score-based ranking
const allCompanies = [...companies].sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title={`${lensLabel} — Companies`} description={`Companies on Belongary where we're gathering belonging data through the ${lensLabel} identity lens.`}>
  <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-3">
      {lensLabel}
    </h1>
    <p class="text-ink/60 mb-8">
      We're gathering belonging data through the <strong>{lensLabel}</strong> lens. Scores for this lens require at least {threshold} reviews to protect anonymity.
    </p>

    <!-- Lens Toggle -->
    <div class="flex flex-wrap gap-2 mb-10">
      <a href="/directory" class="px-4 py-2 rounded-full text-sm font-medium border-2 border-border text-ink/60 hover:border-plum/30 transition-all">
        Everyone
      </a>
      {LENSES.map(lens => (
        <a
          href={`/directory/${lens.id}`}
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium border-2 transition-all',
            lens.id === lensId
              ? 'bg-plum text-white border-plum'
              : 'border-border text-ink/60 hover:border-plum/30'
          ]}
        >
          {lens.label}
        </a>
      ))}
    </div>

    <!-- All companies — no scores to show yet -->
    <div class="bg-white rounded-xl border border-border p-8 text-center mb-8">
      <img src="/brand/icons/belonging.svg" alt="" width="32" height="32" class="mx-auto mb-3 text-plum" aria-hidden="true" />
      <p class="text-lg font-heading font-semibold text-plum mb-2">No {lensLabel} scores yet</p>
      <p class="text-ink/50 text-sm mb-6 max-w-md mx-auto">
        We need at least {threshold} reviews with this lens tag before scores appear. Help us get there.
      </p>
      <a href="/review" class="inline-flex items-center justify-center px-6 py-2.5 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors">
        Leave a Review
      </a>
    </div>

    <h3 class="text-sm font-semibold text-plum mb-4">Companies on Belongary</h3>
    <div class="flex flex-wrap gap-2">
      {allCompanies.map(c => (
        <a href={`/company/${c.slug}`} class="px-3 py-1.5 rounded-full text-xs bg-white border border-border text-ink/60 hover:border-plum/30 transition-colors">
          {c.name}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
