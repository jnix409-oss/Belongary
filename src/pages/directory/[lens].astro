---
import BaseLayout from '../../layouts/BaseLayout.astro';
import companies from '../../data/companies.json';
import { LENSES, getLensLabel } from '../../data/lenses';
import { getHeadlineBadge, getConfidenceLevel, CONFIDENCE_CONFIG } from '../../data/thresholds';

export function getStaticPaths() {
  return LENSES.map(lens => ({ params: { lens: lens.id }, props: { lensId: lens.id, lensLabel: lens.label } }));
}

const { lensId, lensLabel } = Astro.props;

const rankedCompanies = companies
  .filter(c => {
    const lensData = c.reports.by_lens?.[lensId];
    return lensData && lensData.n >= 5;
  })
  .map(c => {
    const lensData = c.reports.by_lens[lensId];
    const pct = Math.round((lensData.yes / (lensData.yes + lensData.no)) * 100);
    return { ...c, lensData, pct, badge: getHeadlineBadge(pct), confidence: getConfidenceLevel(lensData.n) };
  })
  .sort((a, b) => b.pct - a.pct);

const suppressedCompanies = companies.filter(c => {
  const lensData = c.reports.by_lens?.[lensId];
  return lensData && lensData.n > 0 && lensData.n < 5;
});
---
<BaseLayout title={`${lensLabel} — Company Rankings`} description={`Companies ranked by belonging score for ${lensLabel} employees.`}>
  <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-3">
      Rankings: {lensLabel}
    </h1>
    <p class="text-ink/60 mb-8">
      Companies ranked by belonging score, filtered through the <strong>{lensLabel}</strong> identity lens.
    </p>

    <!-- Lens Toggle -->
    <div class="flex flex-wrap gap-2 mb-10">
      <a href="/directory" class="px-4 py-2 rounded-full text-sm font-medium border-2 border-border text-ink/60 hover:border-plum/30 transition-all">
        Everyone
      </a>
      {LENSES.map(lens => (
        <a
          href={`/directory/${lens.id}`}
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium border-2 transition-all',
            lens.id === lensId
              ? 'bg-plum text-white border-plum'
              : 'border-border text-ink/60 hover:border-plum/30'
          ]}
        >
          {lens.label}
        </a>
      ))}
    </div>

    {rankedCompanies.length === 0 ? (
      <div class="bg-white rounded-xl border border-border p-12 text-center">
        <p class="text-lg font-heading font-semibold text-plum mb-2">No companies with enough data yet</p>
        <p class="text-ink/50 text-sm mb-6">We need at least 5 reviews per lens before showing scores. Help us get there.</p>
        <a href="/review" class="inline-flex items-center justify-center px-6 py-2.5 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors">
          Leave a Review
        </a>
      </div>
    ) : (
      <div class="space-y-4">
        {rankedCompanies.map((company, i) => (
          <a href={`/company/${company.slug}?lens=${lensId}`} class="flex items-center gap-4 sm:gap-6 bg-white rounded-xl border border-border p-5 hover:shadow-md hover:border-plum/20 transition-all group">
            <span class="text-2xl font-heading font-bold text-ink/20 w-8 text-right">{i + 1}</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-semibold text-plum group-hover:text-coral transition-colors truncate">{company.name}</h3>
              <div class="flex items-center gap-2 text-xs text-ink/40 mt-0.5">
                <span>{company.industry}</span>
                <span>·</span>
                <span>{company.hq_metro}</span>
                <span>·</span>
                <span>{company.lensData.n} reviews for this lens</span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-light">
                  {CONFIDENCE_CONFIG[company.confidence].label}
                </span>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="text-2xl font-heading font-bold" style={`color: ${company.badge.color}`}>{company.pct}%</span>
              <p class="text-xs font-medium" style={`color: ${company.badge.color}`}>{company.badge.label}</p>
            </div>
          </a>
        ))}
      </div>
    )}

    {suppressedCompanies.length > 0 && (
      <div class="mt-10 bg-cream rounded-xl border border-border p-6">
        <h3 class="text-sm font-semibold text-plum mb-3">Not enough data yet for {lensLabel}</h3>
        <div class="flex flex-wrap gap-2">
          {suppressedCompanies.map(c => (
            <span class="px-3 py-1.5 rounded-full text-xs bg-white border border-border text-ink/50">
              {c.name} ({c.reports.by_lens[lensId].n} review{c.reports.by_lens[lensId].n === 1 ? '' : 's'})
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
