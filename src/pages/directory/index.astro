---
import BaseLayout from '../../layouts/BaseLayout.astro';
import companies from '../../data/companies.json';
import { LENSES } from '../../data/lenses';
import { getThreshold } from '../../data/thresholds';

// Alphabetical — no score-based ranking
const allCompanies = [...companies].sort((a, b) => a.name.localeCompare(b.name));
const threshold = getThreshold();
---
<BaseLayout title="Company Directory" description="Browse companies on Belongary. Help us gather belonging data by leaving a review.">
  <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-3">Company Directory</h1>
    <p class="text-ink/60 mb-8">
      We're gathering belonging data for these companies. Browse by identity lens or help us reach the {threshold}-review threshold by leaving a review.
    </p>

    <!-- Lens Toggle -->
    <div class="flex flex-wrap gap-2 mb-10">
      <a href="/directory" class="px-4 py-2 rounded-full text-sm font-medium border-2 bg-plum text-white border-plum">
        Everyone
      </a>
      {LENSES.map(lens => (
        <a href={`/directory/${lens.id}`} class="px-4 py-2 rounded-full text-sm font-medium border-2 border-border text-ink/60 hover:border-plum/30 transition-all">
          {lens.label}
        </a>
      ))}
    </div>

    <!-- Company List -->
    <div class="space-y-4">
      {allCompanies.map(company => {
        const reviewCount = (company as any).reviewCount ?? 0;
        const pct = Math.min(100, Math.round((reviewCount / threshold) * 100));
        return (
          <a href={`/company/${company.slug}`} class="flex items-center gap-4 sm:gap-6 bg-white rounded-xl border border-border p-5 hover:shadow-md hover:border-plum/20 transition-all group">
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-semibold text-plum group-hover:text-coral transition-colors truncate">{company.name}</h3>
              <div class="flex items-center gap-2 text-xs text-ink/40 mt-0.5">
                <span>{company.industry}</span>
                <span>·</span>
                <span>{company.hq_metro}</span>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <div class="w-24 bg-light rounded-full h-2 overflow-hidden">
                <div
                  class="h-full rounded-full bg-coral/40"
                  style={`width: ${pct}%`}
                ></div>
              </div>
              <span class="text-xs text-ink/40 whitespace-nowrap w-12 text-right">{reviewCount} / {threshold}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
