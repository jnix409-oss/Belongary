---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const navLinks = [
  { href: '/#explore', label: 'Explore workplaces' },
  { href: '/methodology', label: 'Research' },
  { href: '/about', label: 'Our story' },
];
---
<header class:list={[
  'sticky top-0 z-50 backdrop-blur-sm border-b transition-colors',
  dark ? 'bg-plum/90 border-white/10' : 'bg-ivory/90 border-border',
]}>
  <nav class="max-w-content mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src="/brand/logo-wordmark.png"
        alt="Belongary"
        height="36"
        class:list={['h-9 w-auto', dark && 'brightness-0 invert']}
      />
    </a>

    <input type="checkbox" id="mobile-nav" class="hidden peer" />
    <label
      for="mobile-nav"
      class:list={[
        'md:hidden cursor-pointer p-2',
        dark ? 'text-white' : 'text-plum',
      ]}
      aria-label="Toggle navigation"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <ul class:list={[
      'hidden md:flex items-center gap-8',
      'peer-checked:flex peer-checked:flex-col peer-checked:absolute peer-checked:top-full peer-checked:left-0 peer-checked:right-0 peer-checked:px-4 peer-checked:py-4 peer-checked:shadow-lg peer-checked:border-b',
      dark
        ? 'peer-checked:bg-plum peer-checked:border-white/10'
        : 'peer-checked:bg-ivory peer-checked:border-border',
      'md:peer-checked:flex-row md:peer-checked:static md:peer-checked:shadow-none md:peer-checked:border-0 md:peer-checked:p-0',
    ]}>
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              dark
                ? 'text-white/70 hover:text-white'
                : 'text-ink/60 hover:text-plum',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
