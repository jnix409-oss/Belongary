---
const navLinks = [
  { href: '/review', label: 'Share Your Story' },
  { href: '/methodology', label: 'How It Works' },
  { href: '/founder', label: "Founder's Story" },
];
---
<header class="bg-cream-light/80 backdrop-blur-sm border-b border-border sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/brand/logo-wordmark.png" alt="Belongary" height="36" class="h-9 w-auto" />
    </a>

    <input type="checkbox" id="mobile-nav" class="hidden peer" />
    <label for="mobile-nav" class="md:hidden cursor-pointer p-2 text-plum" aria-label="Toggle navigation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <ul class="hidden md:flex items-center gap-6 peer-checked:flex peer-checked:flex-col peer-checked:absolute peer-checked:top-full peer-checked:left-0 peer-checked:right-0 peer-checked:bg-cream-light peer-checked:border-b peer-checked:border-border peer-checked:px-4 peer-checked:py-4 peer-checked:shadow-lg md:peer-checked:flex-row md:peer-checked:static md:peer-checked:shadow-none md:peer-checked:border-0 md:peer-checked:p-0">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-ink/70 hover:text-plum transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
