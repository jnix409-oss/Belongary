---
const footerLinks = [
  { href: '/methodology', label: 'Methodology' },
  { href: '/guidelines', label: 'Community Guidelines' },
  { href: '/anonymity', label: 'How We Protect You' },
  { href: '/dispute', label: 'Dispute Process' },
  { href: '/terms', label: 'Terms of Service' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/about', label: 'About' },
];
---
<footer class="bg-plum text-light/80 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row justify-between gap-8">
      <div>
        <p class="font-heading text-xl font-bold text-light mb-2">Belongary</p>
        <p class="text-sm text-light/60 max-w-xs">
          Glassdoor tells you what people think of a company. Belongary tells you what people like you found there.
        </p>
      </div>
      <div>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2">
          {footerLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-light/60 hover:text-light transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-light/10 text-xs text-light/40">
      &copy; {new Date().getFullYear()} Belongary. All rights reserved.
    </div>
  </div>
</footer>
