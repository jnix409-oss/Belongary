---
const footerLinks = [
  { href: '/about', label: 'About' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---
<footer class="bg-plum text-white/80 mt-16">
  <div class="max-w-content mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <a href="/" class="flex items-center gap-2">
        <img
          src="/brand/logo-wordmark.png"
          alt="Belongary"
          height="28"
          class="h-7 w-auto brightness-0 invert"
        />
      </a>
      <nav aria-label="Footer" class="flex flex-wrap items-center gap-6">
        {footerLinks.map(link => (
          <a href={link.href} class="text-sm text-white/60 hover:text-white transition-colors">
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="mt-8 pt-6 border-t border-white/10 text-xs text-white/40 text-center sm:text-left">
      &copy; {new Date().getFullYear()} Belongary. All rights reserved.
    </div>
  </div>
</footer>
