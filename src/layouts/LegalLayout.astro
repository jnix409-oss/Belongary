---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  draft?: boolean;
}

const { title, draft = false } = Astro.props;
---
<BaseLayout title={title}>
  <div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    {draft && (
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-amber/10 border border-amber/30 px-4 py-1.5 text-sm font-medium text-amber">
        <span>Draft</span>
        <span class="text-ink/60">— Attorney review pending</span>
      </div>
    )}
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-8">{title}</h1>
    <div class="prose prose-plum max-w-none [&_h2]:text-2xl [&_h2]:font-heading [&_h2]:text-plum [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-heading [&_h3]:text-plum [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:text-ink/80 [&_p]:leading-relaxed [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:text-ink/80 [&_li]:mb-2">
      <slot />
    </div>
  </div>
</BaseLayout>
